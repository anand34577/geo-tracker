# Copy to .env next to docker-compose.yml and adjust. Only GT_BASE_URL is really needed;
# everything else is configured in the web UI (Admin → Settings).

# Public URL of your server (used for phone setup links and secure cookies).
GT_BASE_URL=https://track.example.com

# Server timezone: scheduled backups run at the configured hour in this zone.
TZ=Europe/Berlin

# Optional: create the first admin without the setup wizard (useful for automation).
# Remove these lines after the first start. These values are also the local dev test login.
# GT_ADMIN_EMAIL=admin@example.com
# GT_ADMIN_PASSWORD=change-me-please

# Optional: trust X-Forwarded-For from your reverse proxy (CIDR list).
# GT_TRUSTED_PROXIES=172.16.0.0/12

# GT_LOG_LEVEL=info
# GT_LOG_FORMAT=text
