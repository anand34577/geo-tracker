<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers often live on a LAN without TLS; the app warns when a public server uses http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <!-- User-installed CAs are not trusted: they are how traffic gets intercepted. A server with a
             private CA needs a certificate from a public one (e.g. Let's Encrypt), or plain http on the LAN. -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
